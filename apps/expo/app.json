{
  "expo": {
    "name": "HymnMatch",
    "slug": "hymn-match",
    "scheme": "hymnmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-full.png",
      "resizeMode": "cover",
      "backgroundColor": "#0E1A4D"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hymnmatch.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.hymnmatch.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1A4D",
          "image": "./assets/splash-full.png",
          "imageWidth": 400,
          "resizeMode": "cover",
          "android": {
            "backgroundColor": "#0E1A4D",
            "image": "./assets/splash-full.png",
            "resizeMode": "cover",
            "imageWidth": 400
          },
          "ios": {
            "backgroundColor": "#0E1A4D",
            "image": "./assets/splash-full.png",
            "imageWidth": 320,
            "resizeMode": "contain"
          }
        }
      ],
      "./plugins/withDisableGoogleServices"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cfb4de0-435a-45f1-b885-a78dd190c891"
      }
    },
    "owner": "johnadibe500s-team"
  }
}
