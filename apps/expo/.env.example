# HymnMatch (Sermon & Hymn Companion) — MVP

# Google Gemini (free tier via Google AI Studio)
# 1. Open https://aistudio.google.com/apikey
# 2. Sign in with your Google account
# 3. Click "Create API key" → choose a Google Cloud project (or create one)
# 4. Copy the key and paste it below (no quotes)
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional — defaults to gemini-2.0-flash
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# Legacy HandymanKiosk vars (unused by HymnMatch MVP; safe to leave blank)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
