{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "extends": "base"
    },
    "preview": {
      "distribution": "internal",
      "extends": "base"
    },
    "production": {
      "autoIncrement": true,
      "extends": "base"
    },
    "apk": {
      "extends": "preview",
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "apk"
      },
      "prebuildCommand": "node apps/expo/scripts/eas-android-prebuild.mjs"
    }
  },
  "submit": {
    "production": {}
  }
}
